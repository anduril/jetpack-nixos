diff --git a/kdk_gen.py b/kdk_gen.py
--- a/kdk_gen.py
+++ b/kdk_gen.py
@@ -22,1 +22,3 @@
-from ecdsa import NIST256p, SigningKey
+from cryptography.hazmat.primitives import serialization
+from cryptography.hazmat.primitives.asymmetric import ec
+from lib.ftpm_ek import SECP256R1_ORDER
@@ -84,1 +86,1 @@
-        if int_key > 0 and int_key < NIST256p.order:
+        if int_key > 0 and int_key < SECP256R1_ORDER:
@@ -120,2 +122,4 @@ def gen_silicon_id_pubkey(kdk: str, sn: bytes):
