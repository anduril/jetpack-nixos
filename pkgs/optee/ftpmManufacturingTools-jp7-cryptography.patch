@@ -7,0 +8,5 @@
+
+SECP256R1_ORDER = int("FFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551", 16)
+SECP384R1_ORDER = int("FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFC7634D81F4372DDF581A0DB248B0A77AECEC196ACCC52973", 16)
+SECP521R1_ORDER = int("01FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFA51868783BF2F966B7FCC0148F709A5D03BB5C9B8899C47AEBB6FB71E91386409", 16)
+CURVE_ORDERS = {"secp256r1": SECP256R1_ORDER, "secp384r1": SECP384R1_ORDER, "secp521r1": SECP521R1_ORDER}
@@ -11,1 +17,1 @@ class EC_Gen_Key:
-        if curve.name != 'NIST256p' and curve.name != 'NIST384p' and curve.name != 'NIST521p':
+        if curve.name not in ('secp256r1', 'secp384r1', 'secp521r1'):
@@ -21,7 +27,5 @@ class EC_Gen_Key:
-        _req_seed_len = util.orderlen(self.curve.order) + 8
+        curve_order = CURVE_ORDERS[self.curve.name]
+        seed_length = (curve_order.bit_length() + 7) // 8 + 8
-
+
-        _extra_random = self.rand_func(_req_seed_len)
-        _minus_1 = self.curve.order - 1
-        _extra_random = int(_extra_random.hex(), 16) % _minus_1
-        _d = _extra_random + 1
-        _d_hex = _d.to_bytes(util.orderlen(self.curve.order), byteorder='big')
+        extra_random = self.rand_func(seed_length)
+        private_value = int.from_bytes(extra_random, "big") % (curve_order - 1) + 1
@@ -29,2 +33,2 @@ class EC_Gen_Key:
-        _ec_priv_key = SigningKey.from_string(_d_hex, self.curve)
-        _ec_pub_key = _ec_priv_key.get_verifying_key()
